{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db:local": "bash scripts/test-p0-db.sh",
    "test:integration:local": "P1_LOCAL_INTEGRATION=1 node scripts/with-local-supabase-env.mjs npm exec -- vitest run src/lib/astro/selected-context.local.test.ts",
    "test:integration:atros": "P1_ATROS_SANDBOX_INTEGRATION=1 vitest run src/lib/astro/atros-commands.integration.test.ts",
    "test:e2e:smoke": "playwright test tests/e2e/astrologer-smoke.spec.ts",
    "test:e2e:local": "node scripts/with-local-supabase-env.mjs npm run test:e2e:smoke",
    "test:e2e:recovery-visual:local": "NEXT_DIST_DIR=.next-recovery E2E_BASE_URL=http://localhost:9013 E2E_FORCE_NEW_SERVER=1 node scripts/with-local-supabase-env.mjs playwright test tests/e2e/astrologer-recovery-visual.spec.ts --workers=1",
    "test:e2e:provider:local": "node scripts/with-local-supabase-env.mjs playwright test tests/e2e/astrologer-conversation.spec.ts --project=laptop",
    "test:e2e:provider-recovery:local": "P1_PROVIDER_RECOVERY_PROXY=1 OPENGO_BASE_URL=http://127.0.0.1:19082 NEXT_DIST_DIR=.next-recovery E2E_BASE_URL=http://localhost:9012 E2E_FORCE_NEW_SERVER=1 node scripts/with-local-supabase-env.mjs playwright test tests/e2e/astrologer-recovery.spec.ts --project=laptop",
    "test:e2e:staging-recovery": "playwright test tests/e2e/astrologer-staging-recovery.spec.ts --config=playwright.staging.config.ts --workers=1"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.66.0",
    "@vercel/sandbox": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "glob": "^11.0.2",
    "lucide-react": "^0.475.0",
    "next": "^16.3.5",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "rimraf": "^6.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "workflow": "^4.8.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@next/env": "16.3.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.185.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "^8",
    "supabase": "2.117.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
