<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aidoraa" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aidoraa_navy</item>
        <item name="android:statusBarColor">@color/aidoraa_navy</item>
        <item name="android:navigationBarColor">@color/aidoraa_navy</item>
    </style>

    <!-- The launcher hands off to the browser at once; keep it see-through so the
         splash screen is the only thing the person sees. -->
    <style name="Theme.Aidoraa.Launcher" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:statusBarColor">@color/aidoraa_navy</item>
        <item name="android:navigationBarColor">@color/aidoraa_navy</item>
    </style>
</resources>
