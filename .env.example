# AI model provider (OpenRouter, OpenAI-compatible chat completions)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Supabase Auth and database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Required by payment routes and webhooks; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Razorpay server credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# One server-owned product definition. Amount is in the smallest currency unit.
AIDORAA_PAYMENT_AMOUNT_PAISE=
AIDORAA_PAYMENT_CURRENCY=INR
AIDORAA_PAYMENT_PLAN_NAME=Aidoraa access
