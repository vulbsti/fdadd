# AI model provider: OpenCode Go (OpenAI-compatible). OPENROUTER_* is the fallback.
OPENGO_API=
# Optional OpenAI-compatible gateway or local fault proxy. Keep server-only.
OPENGO_BASE_URL=https://opencode.ai/zen/go/v1
ASTROLOGER_PROVIDER_TIMEOUT_MS=45000
CRON_SECRET=
# Optional model override (default: muse-spark-1.3-contributor on Go).
ASTROLOGER_MODEL=
# Optional override for all structured-learning stages. Without an override,
# OpenCode Go uses kimi-k3 for extraction and JSON-schema-guided later stages.
PERSON_CONSOLIDATION_MODEL=

# Supabase Auth and database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Required by payment routes and webhooks; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Razorpay server credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# One server-owned product definition. Amount is in the smallest currency unit.
AIDORAA_PAYMENT_AMOUNT_PAISE=
AIDORAA_PAYMENT_CURRENCY=INR
AIDORAA_PAYMENT_PLAN_NAME=Aidoraa access
